# Copy to .env and adjust. Nothing here is secret for the MVP.

SWAR_HOST=0.0.0.0
SWAR_PORT=8000

# cuda | cpu  -- "auto" picks cuda when available
SWAR_DEVICE=auto

# HuggingFace model id for the L1 anti-spoof classifier.
# Swapped by scripts/fetch_models.py; see config.yaml for the shortlist.
SWAR_SPOOF_MODEL=MelodyMachine/Deepfake-audio-detection-V2

# Where fetched weights land
SWAR_MODEL_DIR=./data/models

# Optional: force the DSP-only fallback detector (useful offline)
SWAR_FORCE_FALLBACK=0

# Frontend dev server -> backend
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/stream
